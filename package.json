{
  "name": "tabkeep",
  "displayName": "Tabkeep",
  "version": "1.0.0",
  "description": "Tab Management Extension",
  "author": "User",
  "scripts": {
    "dev": "plasmo dev --target=chrome-mv3",
    "build": "plasmo build --target=chrome-mv3",
    "package": "plasmo package --target=chrome-mv3"
  },
  "dependencies": {
    "jimp": "^1.6.1",
    "lucide-react": "^0.471.0",
    "plasmo": "0.89.4",
    "pngjs": "^7.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-force-graph-2d": "^1.29.1",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.1",
    "postcss": "8.4.35",
    "tailwindcss": "3.4.1",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "tabs",
      "contextMenus",
      "unlimitedStorage",
      "clipboardRead",
      "identity",
      "alarms"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "oauth2": {
      "client_id": "1010499260088-4brb4qpmqa9km7ek16og7snojqptuoce.apps.googleusercontent.com",
      "scopes": [
        "https://www.googleapis.com/auth/drive.file"
      ]
    }
  }
}
